<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 定位：轨迹采集 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 前台服务：持续记录轨迹 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 网络状态采集 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 屏幕使用时间 / 解锁次数 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 开机自动恢复采集 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 后台常驻：申请加入电池优化白名单（自用侧载，非上架） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 导出报备文件 / 分享 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- 检查更新：下载并安装新版 APK（仍需用户手动确认安装） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      App 名称解析：Android 11+ 有包可见性限制，
      不声明的话 getApplicationInfo() 会抛 NameNotFoundException，
      App 使用排行 / 打开记录就只能显示包名（me.rerere.rikkahub 这种）。
      本项目是自用侧载，不上应用商店，因此直接申请全部包可见性。
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".BeiAnApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeiAn">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BeiAn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              外部打开数据包：在微信 / QQ / 文件管理器里点开 .hh，
              选「用其他应用打开 → 花花动态」即可导入。
              这是「简化导入」的核心 —— 不再需要进 App 里翻文件选择器。

              ⚠️ 说明几个容易踩的点：
                - mimeType 用 */*：微信转发文件时给的 MIME 五花八门
                  （application/octet-stream、application/zip、
                   甚至 text/plain），只声明 application/octet-stream
                  会导致很多机型上微信**根本不列出本 App**。
                - 这里**没有**用 pathPattern 卡 .hh 后缀：微信转发的是
                  content:// 且带临时文件名，系统多半不提供路径数据，
                  写了也匹配不上，反而可能把入口彻底屏蔽掉。
                  所以真正的把关放在内容校验：
                  BackupCipher.decrypt 认不出标记就报错，不会写库。
                - exported=true：必须，否则外部应用无法唤起本 Activity。

              内容层面的把关在 BackupCipher.decrypt / BackupCodec.decode：
              不是本 App 的包会明确报错，不会写进数据库。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="*/*" />
                <data android:scheme="file" android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TrackService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          充电插拔：静态注册，Service 被杀掉也能收到。
          系统广播，必须 exported="true" 才能接收。
        -->
        <receiver
            android:name=".service.StaticEventReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
    <!--
      兜底：个别 ROM 对 QUERY_ALL_PACKAGES 的处理不一致，
      这里显式声明要查询的应用范围。LAUNCHER 类足以覆盖用户会打开的所有 App。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>